def candidate_roots(script_dir: str) -> List[str]:
    """Candidate roots for locating data, image folders, models, and logs."""
    roots = [
        script_dir,
        os.path.dirname(script_dir),
        os.getcwd(),
        os.path.dirname(os.getcwd()),
    ]
    # Remove duplicates while preserving order.
    unique_roots = []
    for r in roots:
        r = os.path.abspath(r)
        if r not in unique_roots:
            unique_roots.append(r)
    return unique_roots


def find_file(filename: str, roots: List[str], extra_subdirs: Optional[List[str]] = None) -> Optional[str]:
    """Find a file from candidate roots and optional subdirectories."""
    extra_subdirs = extra_subdirs or ["", "data", "results", "logs"]
    for root in roots:
        for sub in extra_subdirs:
            path = os.path.join(root, sub, filename)
            if os.path.isfile(path):
                return os.path.abspath(path)
    return None


def find_dir(dirname: str, roots: List[str], extra_subdirs: Optional[List[str]] = None) -> Optional[str]:
    """Find a directory from candidate roots and optional subdirectories."""
    extra_subdirs = extra_subdirs or ["", "data", "images", "spectrograms", "processed_spectrograms"]
    for root in roots:
        for sub in extra_subdirs:
            path = os.path.join(root, sub, dirname)
            if os.path.isdir(path):
                return os.path.abspath(path)
    return None


def ensure_dir(path: str) -> None:
    os.makedirs(path, exist_ok=True)


def resolve_paths(script_dir: str, results_dir_arg: Optional[str] = None) -> Dict[str, str]:
    roots = candidate_roots(script_dir)

    excel_path = find_file("tunnelling_parameter_1.xlsx", roots, ["", "data"])
    if excel_path is None:
        raise FileNotFoundError(
            "Cannot find tunnelling_parameter_1.xlsx. Please place it in the repository root, "
            "the script folder, or a data/ subfolder."
        )

    image_dirs = []
    for sub in IMAGE_SUBDIRS:
        dir_path = find_dir(sub, roots)
        if dir_path is None:
            raise FileNotFoundError(
                f"Cannot find image folder '{sub}'. Please unzip the processed spectrogram dataset "
                f"so that folders {IMAGE_SUBDIRS} are available."
            )
        image_dirs.append(dir_path)

    final_model_path = find_file("final_model.pth", roots, ["", "models", "checkpoints"])
    if final_model_path is None:
        raise FileNotFoundError(
            "Cannot find final_model.pth. Please run Multimodal_model_main_program.py first "
            "to train and save the final model."
        )

    final_scaler_path = find_file("final_scaler.pkl", roots, ["", "models", "checkpoints"])

    # Fold models are usually saved under logs/ in the main script.
    fold_model_paths = {}
    for fold in VALID_FOLDS:
        p = find_file(f"best_model_fold_{fold}.pth", roots, ["logs", "", "models", "checkpoints"])
        if p is not None:
            fold_model_paths[fold] = p

    if results_dir_arg:
        results_dir = os.path.abspath(results_dir_arg)
    else:
        # Put Chapter 5 outputs under the script root if possible.
        results_dir = os.path.join(script_dir, "results", "chapter5_results")
    ensure_dir(results_dir)

    return {
        "excel_path": excel_path,
        "image_dirs": image_dirs,
        "final_model_path": final_model_path,
        "final_scaler_path": final_scaler_path,
        "fold_model_paths": fold_model_paths,
        "results_dir": results_dir,
    }


