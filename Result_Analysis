def section_5_1_1_forward_chaining(paths, data, labels, original_indices, device, skip: bool = False):
    """Section 5.1: blocked temporal forward-chaining evaluation using saved fold models."""
    results_dir = paths["results_dir"]
    image_dirs = paths["image_dirs"]
    fold_model_paths: Dict[int, str] = paths["fold_model_paths"]
    transform_eval = build_eval_transform()
    criterion = nn.CrossEntropyLoss()

    print("\n" + "=" * 80)
    print("Section 5.1.1  Blocked temporal forward-chaining evaluation")
    print("=" * 80)

    if skip:
        print("Skipped by --skip-kfold.")
        return None

    if len(fold_model_paths) == 0:
        print("No saved fold models were found. Skip Section 5.1.1.")
        print("To reproduce this section, run the main training script first and keep logs/best_model_fold_*.pth.")
        return None

    fold_summaries = []
    all_fold_acc = []

    for fold in VALID_FOLDS:
        if fold not in fold_model_paths:
            print(f"Fold {fold}: saved fold model not found, skip this fold.")
            continue

        print("\n" + "-" * 60)
        print(f"Evaluating Fold {fold}: {fold_model_paths[fold]}")

        train_idx, val_idx, test_idx = build_kfold_indices(labels, original_indices, fold)
        params_train = data[train_idx]
        labels_train = labels[train_idx]
        params_test = data[test_idx]
        labels_test = labels[test_idx]

        scaler = StandardScaler()
        scaler.fit(params_train)
        params_test = scaler.transform(params_test)

        test_loader, test_dataset = make_loader(params_test, labels_test, test_idx, image_dirs, transform_eval)
        print(f"Fold {fold} test distribution: {dict(Counter(labels_test))}")
        print(f"Fold {fold} missing images: {test_dataset.missing_count}/{len(test_idx) * 3}")

        model = load_model(fold_model_paths[fold], device)
        test_loss, test_acc, matrix, all_true, all_pred = evaluate(model, test_loader, criterion, device)
        all_fold_acc.append(test_acc)

        report_text = classification_report(all_true, all_pred, target_names=CLASS_NAMES, zero_division=0)
        print(f"Fold {fold} test accuracy: {test_acc:.2f}%")
        print(report_text)

        prefix = os.path.join(results_dir, f"5_1_1_fold{fold}")
        save_text(report_text, prefix + "_classification_report.txt")
        save_dataframe_multi(classification_report_to_dataframe(all_true, all_pred, CLASS_NAMES), prefix + "_classification_report")
        save_prediction_details(all_true, all_pred, test_idx, CLASS_NAMES, prefix + "_predictions")
        save_confusion_matrix_figure(matrix, CLASS_NAMES, prefix + "_confusion_matrix.png")
        save_confusion_matrix_table(matrix, CLASS_NAMES, prefix + "_confusion_matrix")

        report_dict = classification_report(all_true, all_pred, target_names=CLASS_NAMES, output_dict=True, zero_division=0)
        summary = {
            "fold": fold,
            "test_acc": test_acc,
            "test_loss": test_loss,
            "train_size": len(train_idx),
            "val_size": len(val_idx),
            "test_size": len(test_idx),
            "train_dist": str(dict(Counter(labels_train))),
            "test_dist": str(dict(Counter(labels_test))),
            "macro_f1": report_dict["macro avg"]["f1-score"],
            "weighted_f1": report_dict["weighted avg"]["f1-score"],
        }
        for cname in CLASS_NAMES:
            summary[f"{cname}_precision"] = report_dict[cname]["precision"]
            summary[f"{cname}_recall"] = report_dict[cname]["recall"]
            summary[f"{cname}_f1"] = report_dict[cname]["f1-score"]
        fold_summaries.append(summary)

    if len(all_fold_acc) == 0:
        return None

    fold_df = pd.DataFrame(fold_summaries)
    overall_summary_df = pd.DataFrame([{
        "mean_test_acc": float(np.mean(all_fold_acc)),
        "std_test_acc": float(np.std(all_fold_acc)),
        "num_folds": len(all_fold_acc),
    }])

    save_dataframe_multi(fold_df, os.path.join(results_dir, "5_1_1_kfold_fold_metrics"))
    save_dataframe_multi(overall_summary_df, os.path.join(results_dir, "5_1_1_kfold_overall_summary"))

    plt.figure(figsize=(8, 4))
    x = [s["fold"] for s in fold_summaries]
    plt.plot(x, all_fold_acc, marker="o")
    plt.xticks(x)
    plt.xlabel("Fold")
    plt.ylabel("Test Accuracy (%)")
    plt.title("Accuracy across Forward-Chaining Folds")
    plt.grid(True)
    plt.tight_layout()
    plt.savefig(os.path.join(results_dir, "5_1_1_fold_accuracies.png"), dpi=200)
    plt.close()

    print(f"\nForward-chaining mean accuracy: {np.mean(all_fold_acc):.2f}% ± {np.std(all_fold_acc):.2f}%")
    return {"fold_df": fold_df, "overall_summary_df": overall_summary_df}


def prepare_final_test_loader(paths, data, labels, original_indices, device):
    """Reconstruct final chronological train/val/test split and return loaded final model and loaders."""
    image_dirs = paths["image_dirs"]
    transform_eval = build_eval_transform()

    train_idx, val_idx, test_idx = build_final_indices(labels, original_indices)

    params_train = data[train_idx]
    labels_train = labels[train_idx]
    params_val = data[val_idx]
    labels_val = labels[val_idx]
    params_test = data[test_idx]
    labels_test = labels[test_idx]

    if paths.get("final_scaler_path") and os.path.isfile(paths["final_scaler_path"]):
        scaler = joblib.load(paths["final_scaler_path"])
        print(f"Loaded final scaler: {paths['final_scaler_path']}")
    else:
        scaler = StandardScaler()
        scaler.fit(params_train)
        print("final_scaler.pkl was not found. Refit StandardScaler using the reconstructed final training split.")

    params_val = scaler.transform(params_val)
    params_test = scaler.transform(params_test)

    val_loader, val_dataset = make_loader(params_val, labels_val, val_idx, image_dirs, transform_eval)
    test_loader, test_dataset = make_loader(params_test, labels_test, test_idx, image_dirs, transform_eval)

    final_model = load_model(paths["final_model_path"], device)
    print(f"Loaded final model: {paths['final_model_path']}")
