    # This corresponds to directional spectrogram contribution under the multimodal setting.
    base_acc, drops = calculate_directional_image_importance(model, test_loader, device, use_param=True)
    total_drop = sum(drops) if sum(drops) > 0 else 1e-12
    percent = [v / total_drop * 100 for v in drops]

    df = pd.DataFrame({
        "section": "5.2.2",
        "image_channel_id": IMAGE_SUBDIRS,
        "image_channel_name": IMAGE_CHANNEL_NAMES,
