def section_5_2_3_numerical_feature_sensitivity(paths, final_pack, device):
    """Section 5.2.3: permutation-based numerical feature sensitivity analysis."""
    print("\n" + "=" * 80)
    print("Section 5.2.3  Numerical feature sensitivity analysis")
    print("=" * 80)

    model = final_pack["model"]
    params_test = final_pack["params_test"]
    labels_test = final_pack["labels_test"]
    test_idx = final_pack["test_idx"]
    image_dirs = paths["image_dirs"]
    results_dir = paths["results_dir"]
    transform_eval = build_eval_transform()
    criterion = nn.CrossEntropyLoss()

    # Follow the original main program: enable numerical modality and disable image modality.
    prev_param = model.enable_param
    prev_image = model.enable_image
    model.enable_param = True
    model.enable_image = False

    base_dataset = TunnellingDataset(params_test, labels_test, test_idx, image_dirs, transform_eval)
    base_loader = DataLoader(base_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=0)
    _, base_acc, _, _, _ = evaluate(model, base_loader, criterion, device)
    print(f"Numerical-only baseline accuracy: {base_acc:.4f}%")

    rows = []
    for j, feature_name in enumerate(FEATURE_COLS):
        params_shuffled = params_test.copy()
        rng = np.random.default_rng(42 + j)  # deterministic permutation for each feature
        rng.shuffle(params_shuffled[:, j])

        dataset = TunnellingDataset(params_shuffled, labels_test, test_idx, image_dirs, transform_eval)
        loader = DataLoader(dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=0)
        _, acc, _, _, _ = evaluate(model, loader, criterion, device)

        sensitivity_score = abs(base_acc - acc)
        print(f"{feature_name}: shuffled_acc={acc:.4f}%, sensitivity_score={sensitivity_score:.4f}")
        rows.append({
            "section": "5.2.3",
            "feature": feature_name,
            "baseline_accuracy_numerical_only": base_acc,
            "accuracy_after_permutation": acc,
            "sensitivity_score": sensitivity_score,
        })

    model.enable_param = prev_param
    model.enable_image = prev_image

    df = pd.DataFrame(rows)
    save_dataframe_multi(df, os.path.join(results_dir, "5_2_3_numerical_feature_sensitivity"))
    plot_and_save_bar(
        values=df["sensitivity_score"].values.tolist(),
        labels=df["feature"].values.tolist(),
        title="Numerical Feature Sensitivity",
        ylabel="Sensitivity score (%)",
        base_path_no_ext=os.path.join(results_dir, "5_2_3_numerical_feature_sensitivity"),
    )
    return df


