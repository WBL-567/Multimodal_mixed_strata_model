    print("  val:  ", dict(Counter(labels_val)))
    print("  test: ", dict(Counter(labels_test)))
    print(f"Final val missing images:  {val_dataset.missing_count}/{len(val_idx) * 3}")
    print(f"Final test missing images: {test_dataset.missing_count}/{len(test_idx) * 3}")

    return {
        "model": final_model,
        "scaler": scaler,
        "val_loader": val_loader,
        "test_loader": test_loader,
        "val_idx": val_idx,
        "test_idx": test_idx,
        "params_test": params_test,
        "labels_test": labels_test,
        "labels_val": labels_val,
        "labels_test_raw": labels_test,
    }


