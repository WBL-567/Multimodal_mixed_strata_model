@torch.no_grad()
def calculate_directional_image_importance(model, test_loader, device, use_param: bool = True):
    """Set each directional spectrogram to zero and calculate the accuracy drop."""
    criterion = nn.CrossEntropyLoss()

    prev_param = model.enable_param
    prev_image = model.enable_image
    model.enable_param = use_param
    model.enable_image = True

    _, base_acc, _, _, _ = evaluate(model, test_loader, criterion, device)
    importance = []

    for img_zero_idx in range(3):
        model.eval()
        running_correct = 0
        total = 0
        for params, img1, img2, img3, labels in test_loader:
            params = params.to(device)
            img1 = img1.to(device)
            img2 = img2.to(device)
            img3 = img3.to(device)
            labels = labels.to(device)

            imgs = [img1, img2, img3]
            imgs[img_zero_idx] = torch.zeros_like(imgs[img_zero_idx])

            outputs = model(params, imgs[0], imgs[1], imgs[2])
            _, predicted = outputs.max(1)
            total += labels.size(0)
            running_correct += predicted.eq(labels).sum().item()

        acc_after_zeroing = 100.0 * running_correct / total
        drop = base_acc - acc_after_zeroing
        importance.append(drop)
        print(
            f"{IMAGE_CHANNEL_NAMES[img_zero_idx]} spectrogram zeroed: "
            f"base_acc={base_acc:.4f}%, acc={acc_after_zeroing:.4f}%, drop={drop:.4f}"
        )

    model.enable_param = prev_param
    model.enable_image = prev_image
    return base_acc, importance


def section_5_2_2_directional_spectrogram_contribution(paths, final_pack, device):
    """Section 5.2.2: contribution of vertical, horizontal, and axial spectrograms."""
    print("\n" + "=" * 80)
